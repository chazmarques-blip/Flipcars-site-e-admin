# Application
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=flipcars
DATABASE_PASSWORD=flipcars123
DATABASE_NAME=flipcars_dev
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true

# JWT Authentication (Development keys - DO NOT USE IN PRODUCTION)
JWT_SECRET=dev-jwt-secret-key-2025
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=dev-refresh-secret-key-2025
JWT_REFRESH_EXPIRATION=7d

# OpenAI API (Use your own key)
OPENAI_API_KEY=sk-placeholder-replace-with-real-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Google Vision API (VIN Scanner)
GOOGLE_VISION_API_KEY=AIzaSyAPqvOGH85AA8YIbLwAe5IRz3j5KtFtNOc

# AWS S3 (Development credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_S3_BUCKET=flipcars-dev-uploads
AWS_S3_PUBLIC_URL=http://localhost:9000/flipcars-dev-uploads

# Email (Development - use Mailhog)
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=dev@flipcars.us
EMAIL_FROM_NAME=FlipCars Dev

# SMS/WhatsApp (Development - mock)
TWILIO_ACCOUNT_SID=dev-placeholder
TWILIO_AUTH_TOKEN=dev-placeholder
TWILIO_PHONE_NUMBER=+11234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+11234567890

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting (More lenient in dev)
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
