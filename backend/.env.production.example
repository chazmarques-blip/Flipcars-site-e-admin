# ============================================
# FlipCars Backend - Production Environment
# ============================================

# Application
NODE_ENV=production
PORT=3001

# Frontend URLs (comma-separated for CORS)
FRONTEND_URL=https://flipcars.us,https://www.flipcars.us,https://admin.flipcars.us

# Database (Railway PostgreSQL)
# Get this from Railway PostgreSQL service variables
DATABASE_TYPE=postgres
DATABASE_HOST=${{PGHOST}}
DATABASE_PORT=${{PGPORT}}
DATABASE_USERNAME=${{PGUSER}}
DATABASE_PASSWORD=${{PGPASSWORD}}
DATABASE_NAME=${{PGDATABASE}}
DATABASE_URL=${{DATABASE_URL}}
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# JWT Authentication
# IMPORTANT: Generate secure secrets in production!
# Use: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_SECRET_MIN_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRATION=7d

# OpenAI API (Optional - for AI features)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# AWS S3 (Optional - for file uploads)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=flipcars-uploads-production
AWS_S3_PUBLIC_URL=https://flipcars-uploads-production.s3.amazonaws.com

# Email (Optional - SendGrid or AWS SES)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@flipcars.us
EMAIL_FROM_NAME=FlipCars

# SMS/WhatsApp (Optional - Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Redis (Optional - Railway Redis for caching)
REDIS_HOST=${{REDIS_HOST}}
REDIS_PORT=${{REDIS_PORT}}
REDIS_PASSWORD=${{REDIS_PASSWORD}}
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# RAILWAY DEPLOYMENT NOTES:
# ============================================
#
# 1. PostgreSQL Setup:
#    - Add "PostgreSQL" service in Railway
#    - Railway auto-provides: PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE, DATABASE_URL
#    - No need to manually set these
#
# 2. Redis Setup (Optional):
#    - Add "Redis" service in Railway
#    - Railway auto-provides: REDIS_HOST, REDIS_PORT, REDIS_PASSWORD
#
# 3. JWT Secrets:
#    - Generate secure secrets: openssl rand -base64 32
#    - Add as environment variables in Railway dashboard
#
# 4. Domain Configuration:
#    - Add custom domain: api.flipcars.us
#    - Update DNS: CNAME record pointing to Railway domain
#
# 5. Database Migrations:
#    - Railway runs migrations automatically on deploy
#    - Or manually: railway run npm run migration:run
#
# 6. Seed Data:
#    - Run seed after first deploy: railway run npm run seed
#
# ============================================
